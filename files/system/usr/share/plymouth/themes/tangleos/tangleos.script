// TangleOS Plymouth theme — adattato per Fedora Atomic
// Sfondo scuro + logo centrato + spinner animato (36 frame)
// + gestione richiesta password (necessaria se il disco è cifrato con LUKS)

Window.SetBackgroundTopColor(0.11, 0.11, 0.12);
Window.SetBackgroundBottomColor(0.08, 0.08, 0.09);

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

// ---- Logo centrato ----
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen_width  / 2 - logo.image.GetWidth()  / 2;
logo.y = screen_height / 2 - logo.image.GetHeight() / 2 - 60;
logo.sprite.SetPosition(logo.x, logo.y, 10000);

// ---- Spinner animato ----
throbber.num_frames = 36;
for (i = 0; i < throbber.num_frames; i++) {
  throbber.images[i] = Image("throbber/throbber-" + PadLeft(i, 3, "0") + ".png");
}
throbber.sprite = Sprite();
throbber.x = screen_width  / 2 - throbber.images[0].GetWidth()  / 2;
throbber.y = screen_height / 2 + logo.image.GetHeight() / 2 - 10;
throbber.sprite.SetPosition(throbber.x, throbber.y, 10000);

fun refresh_callback() {
  frame = (Plymouth.GetElapsedTime() * 18) % throbber.num_frames;
  throbber.sprite.SetImage(throbber.images[Math.Int(frame)]);
}
Plymouth.SetRefreshFunction(refresh_callback);

// ---- Richiesta password (sblocco disco cifrato) ----
prompt.sprite = Sprite();
bullets.sprite = Sprite();

fun display_password_callback(prompt_text, bullet_count) {
  prompt.image = Image.Text(prompt_text, 0.85, 0.85, 0.85);
  prompt.sprite.SetImage(prompt.image);
  prompt.sprite.SetPosition(screen_width / 2 - prompt.image.GetWidth() / 2, throbber.y + 130, 10002);
  prompt.sprite.SetOpacity(1);

  text = "";
  for (i = 0; i < bullet_count; i++) {
    text = text + "*";
  }
  if (text == "") text = " ";
  bullets.image = Image.Text(text, 0.75, 0.44, 0.32);
  bullets.sprite.SetImage(bullets.image);
  bullets.sprite.SetPosition(screen_width / 2 - bullets.image.GetWidth() / 2, throbber.y + 165, 10002);
  bullets.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  prompt.sprite.SetOpacity(0);
  bullets.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// ---- Messaggi di stato ----
fun message_callback(text) {
  my_message.image = Image.Text(text, 0.85, 0.85, 0.85);
  my_message.sprite = Sprite(my_message.image);
  my_message.sprite.SetPosition(screen_width / 2 - my_message.image.GetWidth() / 2,
                                screen_height - 80, 10001);
}
Plymouth.SetMessageFunction(message_callback);
